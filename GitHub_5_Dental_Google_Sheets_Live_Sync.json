    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  id AS appointment_id,\n  patient_name,\n  phone,\n  doctor_name,\n  COALESCE(service_type, 'كشف أسنان') AS service_type,\n  appointment_date::text AS appointment_date,\n  appointment_time,\n  CASE\n    WHEN status = 'cancelled' THEN '❌ ملغي (Cancelled)'\n    WHEN status = 'confirmed' AND decision_locked = TRUE THEN '🟢 أكد الحضور النهائي'\n    ELSE '✅ حجز مؤكد'\n  END AS status_arabic,\n  CASE WHEN reminder_24h_sent THEN 'تم الإرسال ✓' ELSE 'لم يرسل' END AS reminder_24h,\n  CASE WHEN reminder_3h_sent THEN 'تم الإرسال ✓' ELSE 'لم يرسل' END AS reminder_3h,\n  COALESCE(rating_score::text || ' / 5 ⭐', 'لم يقيم بعد') AS rating,\n  COALESCE(notes, 'حجز عبر البوت') AS notes,\n  COALESCE(decision_at::text, created_at::text) AS last_updated\nFROM public.appointments\nORDER BY id DESC\nLIMIT 100;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1160,
        510
      ],
      "id": "96b638eb-54e7-4b29-bb64-a3406bc867bd",
